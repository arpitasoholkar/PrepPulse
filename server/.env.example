PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster-host>/intelliprep?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
FALLBACK_API_KEY=your_key_here
FALLBACK_BASE_URL=https://api.x.ai/v1
FALLBACK_MODEL=<model id from the list call below>
AI_TIMEOUT_MS=15000