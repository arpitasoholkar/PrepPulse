PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster-host>/intelliprep?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
FALLBACK_API_KEY=your_key_here
FALLBACK_BASE_URL=https://api.x.ai/v1
FALLBACK_MODEL=<model id from the list call below>
AI_TIMEOUT_MS=15000
# --- Semantic recall (MongoDB Atlas Vector Search). All optional: without them recall is structured-only. ---
# Reuses GEMINI_API_KEY for embeddings. Set DISABLE_VECTOR=1 to switch semantic recall off.
EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768
# RECALL_MIN_SIM=0.6
# VECTOR_INDEX_NAME=memory_vector_index
# DISABLE_VECTOR=1
